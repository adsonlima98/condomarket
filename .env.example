# ─── OBRIGATORIO EM PRODUCAO ───────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua-por-uma-string-aleatoria-longa

# ─── BANCO DE DADOS ────────────────────────────────────────────────────────
# SQLite (padrao, nao recomendado em producao):
# DATABASE_URL=sqlite:///marketplace.db
# PostgreSQL (recomendado em producao):
# DATABASE_URL=postgresql://usuario:senha@host:5432/condomarket

# ─── ADMINISTRADOR ─────────────────────────────────────────────────────────
ADMIN_PASSWORD=troque-por-uma-senha-segura
ADMIN_PHONE=11999999999

# ─── CORS ──────────────────────────────────────────────────────────────────
# Defina o dominio real do seu app (ex: https://meuapp.com)
# Separe multiplos dominios por virgula
ALLOWED_ORIGINS=*

# ─── BCRYPT ────────────────────────────────────────────────────────────────
# Custo de hash (12 = padrao seguro; nao altere em producao)
BCRYPT_ROUNDS=12

# ─── SENHA MINIMA ──────────────────────────────────────────────────────────
PASSWORD_MIN_LEN=8

# ─── DADOS DE DEMO (apenas desenvolvimento) ────────────────────────────────
# SEED_DATA=true
